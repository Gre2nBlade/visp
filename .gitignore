# Сборочные каталоги Flutter
build/
**/.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies

# Ephemeral-каталоги Flutter по платформам.
# Полные правила для ios/macos/linux/windows лежат в одноимённых .gitignore.
windows/flutter/ephemeral/
linux/flutter/ephemeral/
macos/Flutter/ephemeral/
ios/Pods/
ios/.symlinks/
ios/Flutter/ephemeral/

# Секреты окружения
.env
.env.*
!.env.example

# IDE
.idea/
.vscode/
*.iml

# Крупные бинарники и артефакты.
# Исключение: android/app/libs/amneziawg-bridge.aar обязателен в репозитории,
# иначе сборка на чистой машине не запустит AmneziaWG.
*.fig
*.apk
*.aab
*.ipa
*.zip
*.tar.gz
*.exe
*.dll
*.so
*.a

# Gradle / CocoaPods локальные кэши
.gradle/

# Coverage
coverage/

# Инструментальные скрипты
node_modules/

# Логи
*.log

# Мусор ОС
.DS_Store
Thumbs.db
desktop.ini

# Остатки конфликтов слияния
*.orig
*.rej
*.bak

# Тимповые файлы (пустые/отладочные)
_*.txt
_*.html
_*.js
_*.png

# Локальные инструкции для ИИ-агентов: осознанно не попадают в репозиторий.
# Ключи Android (key.properties, *.jks, *.keystore) и .cxx/ исключены
# в android/.gitignore, local.properties и Generated.xcconfig — в платформенных.
AGENTS.md
CLAUDE.md